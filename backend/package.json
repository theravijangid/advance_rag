{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "build:prod": "NODE_ENV=production npm run build",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "format": "prettier --write .",
    "generate_migration": "npx sequelize-cli migration:generate --name",
    "generate_seed": "npx sequelize-cli seed:generate --name",
    "migrate": "NODE_OPTIONS='-r ts-node/register' npx sequelize-cli db:migrate",
    "seed": "NODE_OPTIONS='-r ts-node/register' npx sequelize-cli db:seed:all",
    "migrate:undo": "NODE_OPTIONS='-r ts-node/register' npx sequelize-cli db:migrate:undo --name",
    "seed:undo": "NODE_OPTIONS='-r ts-node/register' npx sequelize-cli db:seed:undo:all"
  },
